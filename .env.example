# Copy to .env next to compose.yaml and fill in.
# A long random access key (e.g. from a password manager). Used to log in and by Claude Desktop (centen remote).
CENTEN_KEY=change-me-to-a-long-random-key
# Owner of the ./data folder on the NAS (Synology: run `id` over SSH, or use 1026/100 for the first admin user).
PUID=1000
PGID=1000
